# ---------------------------------------------------------------------------
# School Results Management & Report Card Portal - Backend environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="School Results Portal"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- MySQL database ---
# These are read individually and assembled into the SQLAlchemy URL.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=change_me
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=school_results_portal

# Optional: set DATABASE_URL to override the assembled URL entirely. Leave it
# commented out to use the MYSQL_* values above - an uncommented DATABASE_URL
# silently wins over every one of them.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/school_results_portal

# --- Security / JWT ---
# Required. The API refuses to start without a real key of its own, because
# anyone who knows this value can mint a token for any account, administrators
# included. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# bcrypt work factor. 12 is the default; lower to 10 or 11 only if sign-in
# feels slow on your server. Never below 10.
BCRYPT_ROUNDS=12

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- School branding (used on generated report cards) ---
# Sign-in domain for learners with no email address of their own.
# Must be syntactically valid; do not use .local or .invalid.
STUDENT_EMAIL_DOMAIN=students.internal

# Where uploaded files (school logo, result CSVs) are stored.
UPLOAD_DIR=uploads

SCHOOL_NAME="Springfield Senior Secondary School"
SCHOOL_MOTTO="Knowledge. Integrity. Service."

# ---------------------------------------------------------------------------
# Email delivery (transactional)
# ---------------------------------------------------------------------------
# When an administrator creates an account, the generated temporary password is
# emailed to the holder. It is never shown in the UI, never returned by the
# API, and never stored in plaintext - so if email is not configured, nobody
# can sign in to a new account.

# Master switch. Leave false locally unless you are testing delivery.
EMAIL_ENABLED=false

# "smtp"  any transactional provider - SendGrid, Mailgun, Postmark, SES,
#         Resend, or your school's own relay. All of them speak SMTP.
# "file"  writes the rendered message to EMAIL_OUTBOX_DIR instead of sending.
#         Development only; refused when ENVIRONMENT is production.
EMAIL_PROVIDER=smtp

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# STARTTLS on port 587 (the usual choice), or implicit TLS on 465.
# Never set both to false against a provider on the public internet.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=20

# Refuse to create an account whose address cannot receive mail: the domain is
# checked for a mail exchanger first, and a failed send discards the account.
# Catches a domain that does not exist; cannot catch a missing mailbox at a
# real domain, which only a bounce reports.
EMAIL_REQUIRE_DELIVERABLE=true

# The From: address. It must be one the provider has authorised you to send
# as, or the message will be rejected or land in spam.
EMAIL_FROM=
EMAIL_FROM_NAME=

# Where EMAIL_PROVIDER=file drops messages. Development only; gitignored.
EMAIL_OUTBOX_DIR=var/outbox

# Public origin of the React app. Used to build the sign-in link in the email.
# No trailing slash.
FRONTEND_URL=http://localhost:5173
