# ---------------------------------------------------------------------------
# School Results Management & Report Card Portal - Backend environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="School Results Portal"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- MySQL database ---
# These are read individually and assembled into the SQLAlchemy URL.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=change_me
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=school_results_portal

# Optional: set DATABASE_URL to override the assembled URL entirely. Leave it
# commented out to use the MYSQL_* values above - an uncommented DATABASE_URL
# silently wins over every one of them.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/school_results_portal

# --- Security / JWT ---
# Required. The API refuses to start without a real key of its own, because
# anyone who knows this value can mint a token for any account, administrators
# included. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# bcrypt work factor. 12 is the default; lower to 10 or 11 only if sign-in
# feels slow on your server. Never below 10.
BCRYPT_ROUNDS=12

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Student admission numbering and credential slips ---
STUDENT_NUMBER_PREFIX=PHS
STUDENT_NUMBER_SEQUENCE_WIDTH=3
CREDENTIAL_SLIP_TTL_MINUTES=10

# Where uploaded files (school logo, result CSVs) are stored.
UPLOAD_DIR=uploads

SCHOOL_NAME="Springfield Senior Secondary School"
SCHOOL_MOTTO="Knowledge. Integrity. Service."

# Public origin of the React app. Used in downloadable credential slips.
# No trailing slash.
FRONTEND_URL=http://localhost:5173
