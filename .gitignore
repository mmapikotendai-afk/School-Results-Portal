# ---------------------------------------------------------------------------
# School Results Management & Report Card Portal
#
# The real .env files stay on the machine that runs the portal. Only the
# .example templates, which carry variable names and never values, are shared.
# ---------------------------------------------------------------------------

# Environment variables
.env
.env.*
!.env.example
*.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Node
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Testing / cache
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Local database files
*.db
*.sqlite
*.sqlite3

# Uploaded content. The school crest and any other uploaded file belong to the
# installation, not to the source tree; the application recreates the folder.
backend/uploads/
uploads/

# Third-party agent skills vendored from github.com/ConardLi/garden-skills.
# Active locally, deliberately not part of this project's history.
.claude/skills/
