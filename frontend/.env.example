# ---------------------------------------------------------------------------
# Frontend environment. Copy to `.env` and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the browser -
# never put secrets in this file.
# ---------------------------------------------------------------------------

# Base URL the Axios client calls. Leave as "/api/v1" to use the dev proxy
# configured in vite.config.js. In production set the full API origin, e.g.
# VITE_API_BASE_URL=https://api.yourschool.edu/api/v1
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api requests (development only).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Dev server port
VITE_PORT=5173

# School branding shown in the UI
VITE_SCHOOL_NAME=Springfield Senior Secondary School
VITE_SCHOOL_SHORT_NAME=Springfield
VITE_SCHOOL_MOTTO=Knowledge. Integrity. Service.
